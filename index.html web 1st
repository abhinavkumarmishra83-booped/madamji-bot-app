    <!-- JavaScript for Panel Sliding & Image Carousel -->
    <script>
        // Panel Slider Logic (5 Slides Support)
        let currentPanel = 0;
        const track = document.getElementById('panelsTrack');
        const pDots = document.querySelectorAll('.p-dot');

        function switchPanel(index) {
            currentPanel = index;
            track.style.transform = `translateX(-${currentPanel * 100}%)`;
            pDots.forEach((dot, idx) => {
                dot.classList.toggle('active', idx === currentPanel);
            });
        }

        // Touch Swipe Gesture for Mobile
        let touchStartX = 0;
        let touchEndX = 0;

        track.addEventListener('touchstart', e => {
            touchStartX = e.changedTouches[0].screenX;
        });

        track.addEventListener('touchend', e => {
            touchEndX = e.changedTouches[0].screenX;
            handleGesture();
        });

        function handleGesture() {
            if (touchEndX < touchStartX - 50 && currentPanel < 4) {
                switchPanel(currentPanel + 1);
            }
            if (touchEndX > touchStartX + 50 && currentPanel > 0) {
                switchPanel(currentPanel - 1);
            }
        }

        // Inner Image Carousel inside Slide 1
        let slideIndex = 0;
        const slides = document.querySelectorAll('#slider1 .slide');
        const dots = document.querySelectorAll('#slider1 .dot');

        function showSlides() {
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            
            slideIndex++;
            if (slideIndex > slides.length) { slideIndex = 1; }
            
            slides[slideIndex - 1].classList.add('active');
            dots[slideIndex - 1].classList.add('active');
            
            setTimeout(showSlides, 4000); 
        }

        function currentSubSlide(n) {
            slideIndex = n;
            slides.forEach(slide => slide.classList.remove('active'));
            dots.forEach(dot => dot.classList.remove('active'));
            
            slides[slideIndex].classList.add('active');
            dots[slideIndex].classList.add('active');
        }

        setTimeout(showSlides, 4000);
    </script>
